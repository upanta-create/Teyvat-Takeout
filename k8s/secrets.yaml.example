apiVersion: v1
kind: Secret
metadata:
  name: teyvat-secrets
  namespace: teyvat-takeout
type: Opaque
stringData:
  MONGO_URL: "mongodb://teyvat-mongodb:27017/teyvat_takeout"
  JWT_SECRET: "your_production_grade_jwt_secret_key_change_me"
  STRIPE_SECRET_KEY: "sk_live_your_production_stripe_secret_key"
