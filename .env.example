# ============================================================
# Teyvat Takeout — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file — it is gitignored.
# ============================================================

# ---- Security -----------------------------------------------
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=your-strong-random-jwt-secret-here

# Bcrypt salt rounds (default: 10)
SALT=10

# ---- Stripe Payments ----------------------------------------
# Use a test key from https://dashboard.stripe.com/test/apikeys
# Test keys start with sk_test_  |  Live keys start with sk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# ---- URLs ---------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---- Logging ------------------------------------------------
# Options: error | warn | info | http | debug
LOG_LEVEL=info
