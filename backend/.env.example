# -------------------------------------------------------------
# Teyvat Takeout Backend Environment Configuration
# -------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGO_URL=mongodb://127.0.0.1:27017/teyvat_takeout

# Redis Cache (Local or Redis Cloud URL)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=teyvat_takeout_super_secret_jwt_key_2026
SALT=10

# Stripe Payment Gateway (Test API Key)
STRIPE_SECRET_KEY=sk_test_51MockKeyTeyvatTakeoutStripeIntegration

# Client Web Application URL (for Stripe redirect verification)
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Transactional Email (SMTP) — Optional. Uses Ethereal test account in dev if not set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
