{
  "name": "teyvat-takeout-backend",
  "version": "1.0.0",
  "description": "Production REST API for Teyvat Takeout with Prometheus RED metrics & structured logging",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "server": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testEnvironment node",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --testEnvironment node"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js"
    ]
  },
  "author": "upanta-create",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.1",
    "nodemon": "^3.1.4",
    "prom-client": "^15.1.3",
    "stripe": "^16.6.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
